# ==================================================
# RAY AI BACKEND - ENVIRONMENT VARIABLES
# ==================================================
# Copy this file to .env and fill in your values

# ==================================================
# DATABASE CONFIGURATION
# ==================================================

# PostgreSQL connection string
# Format: postgresql://username:password@host:port/database
DATABASE_URL=postgresql://ray_user:ray_password@localhost:5432/ray_ai_db

# ==================================================
# FIREBASE CONFIGURATION
# ==================================================

# Path to Firebase service account credentials JSON
# Download from Firebase Console → Project Settings → Service Accounts
FIREBASE_CREDENTIALS_PATH=firebase_credentials.json

# ==================================================
# GROQ AI CONFIGURATION
# ==================================================

# Get your API key from: https://console.groq.com
GROQ_API_KEY=gsk_your_api_key_here

# Model to use (default: llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# API timeout in seconds
GROQ_TIMEOUT=30

# Max retries for transient errors
GROQ_MAX_RETRIES=3

# ==================================================
# API CONFIGURATION
# ==================================================

# Server host (0.0.0.0 = all interfaces)
API_HOST=0.0.0.0

# Server port
API_PORT=8000

# ==================================================
# LOGGING CONFIGURATION
# ==================================================

# Log file location (created automatically)
LOG_FILE=logs/ray_ai.log

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# ==================================================
# CORS CONFIGURATION
# ==================================================

# Allowed origins (comma-separated for production)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000,https://ray-ai.com

# ==================================================
# OPTIONAL CONFIGURATIONS
# ==================================================

# Application environment
ENVIRONMENT=development  # or: production

# Debug mode (set to false in production)
DEBUG=true

# ==================================================
# NOTES
# ==================================================
# 1. NEVER commit .env file to version control
# 2. Use strong passwords for PostgreSQL
# 3. Keep API keys secure and rotate regularly
# 4. In production, use environment variables instead of .env file
# 5. Create logs/ directory before running
